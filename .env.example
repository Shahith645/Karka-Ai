# Railway: copy the MySQL "public" connection URL (starts with mysql://)
DATABASE_URL=mysql://user:password@host:port/railway
# Admin login (choose your own; change the password any time and redeploy)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-unique-password
# Long random text, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
NODE_ENV=production
